}

/**
 * Three-part general coach: craft note, line to strengthen, story musing.
 * Fires three small focused calls rather than one multi-part call, so each
 * part gets a clear instruction and reliable output.
 */
async function coachGeneral(passage: string): Promise<string> {
  const excerpt = passage.length > 1200 ? '...' + passage.slice(-1200) : passage;
  const lorebookContext = await getActivatedLorebookContext(excerpt);

  const callGen = async (prompt: string, maxTokens: number): Promise<string> => {
    try {
      const response = await generateWithBudgetWait(
        [{ role: 'user', content: prompt }],
        { model: 'glm-4-6', max_tokens: maxTokens, temperature: 1.0, stop: ['\n\n'] },
        undefined,
        'background'
      );
      if (!response.choices || response.choices.length === 0) return '';
      return response.choices[0].text.trim();
    } catch (e) {
      api.v1.error('General coach error:', e);
      return '';
    }
  };

  const craftPrompt = `You are a prose coach. In ONE sentence only, give the single most useful craft observation about this passage — pacing, rhythm, texture, or structure. No preamble.\n\nPASSAGE:\n${excerpt}${lorebookContext}`;
  const strengthenPrompt = `You are a prose coach. In ONE sentence only, either quote or closely paraphrase one specific sentence from the passage below that could be strengthened and briefly say why — or write exactly: Nothing stands out. No preamble.\n\nPASSAGE:\n${excerpt}${lorebookContext}`;
  const musingPrompt = `You are a prose coach. In ONE sentence only, offer a purely speculative imaginative musing about what might be happening in the larger story or world hinted at by this passage. Do not comment on craft. No preamble.\n\nPASSAGE:\n${excerpt}${lorebookContext}`;

  // Run sequentially — parallel background calls may silently drop results
  const craft = await callGen(craftPrompt, 80);
  const strengthen = await callGen(strengthenPrompt, 80);
  const musing = await callGen(musingPrompt, 80);

  return [craft, strengthen, musing].filter(Boolean).join('\n');
}

async function coachGeneralRevision(generalLine: string, passage: string): Promise<string> {
  const excerptSource = pickSingleLineContext(generalLine, passage);
  const excerpt = excerptSource.length > 1200 ? '...' + excerptSource.slice(-1200) : excerptSource;
  const lorebookContext = await getActivatedLorebookContext(excerpt);
  const prompt = `You are a surgical prose coach. The writer received this note about a sentence that could be strengthened:\n${generalLine}\n\nFrom the passage context below, identify the exact sentence being referred to, explain the issue briefly, and give one revised sentence that preserves the story facts and tone. Be direct and surgical. Output exactly in this format, one item per line:\nTARGET: [exact sentence copied verbatim from the passage]\nISSUE: [brief reason]\nREVISION: [one revised sentence]\n\nPASSAGE:\n${excerpt}${lorebookContext}`;

  try {
    const response = await generateWithBudgetWait(
      [{ role: 'user', content: prompt }],
      {
        model: 'glm-4-6',
        max_tokens: 260,
        temperature: state.config.temperature,
        stop: ['\n\n\n']
      },
      undefined,
      'background'
    );

    if (!response.choices || response.choices.length === 0) return '(No response)';
    return response.choices[0].text.trim();
  } catch (e) {
    api.v1.error('General revision coach error:', e);
    return '(Error generating coaching)';
  }
}

function pickSingleLineContext(note: string, passage: string): string {
  const lines = passage.split(/\r?\n/).map(line => line.trim()).filter(Boolean);
  if (lines.length <= 1) return passage.trim();

  const quoted = note.match(/["\u201C]([^"\u201D]{12,})["\u201D]/);
  if (quoted) {
    const quote = quoted[1].trim();
    const exact = lines.find(line => line.includes(quote));
    if (exact) return exact;
  }

  const noteWords = new Set((note.toLowerCase().match(/\b[a-z]{4,}\b/g) ?? []));
  let bestLine: string = lines[lines.length - 1] ?? passage.trim();
  let bestScore = -1;
  for (const line of lines) {
    const words = line.toLowerCase().match(/\b[a-z]{4,}\b/g) ?? [];
    const score = words.filter(word => noteWords.has(word)).length;
    if (score > bestScore) {
      bestScore = score;
      bestLine = line;
    }
  }

  return bestLine;
}

// ============================================================================
// AUTO-ANALYSIS (fires after generation, no AI cost for SDT/Tag)
// ============================================================================

async function runAutoAnalysis(force: boolean = false, includeGeneralCoach: boolean = true): Promise<void> {
  const scanned = await api.v1.document.scan();
  if (scanned.length === 0) return;

  const fullText = scanned.map(s => s.section.text).join('\n');

  // Trim to token window — work out how many sections fit from the end
  let sectionTexts: string[] = scanned.map(s => s.section.text);
  let analysisText = fullText;
  if (fullText.length > 0) {
    try {
      const tokens = await api.v1.tokenizer.encode(fullText, 'glm-4-6');
      if (tokens.length > state.config.tokenWindow) {
        const trimmed = tokens.slice(-state.config.tokenWindow);
        analysisText = await api.v1.tokenizer.decode(trimmed, 'glm-4-6');
        // Re-derive per-section texts from the trimmed window
        // Keep sections from the end until we exceed the trimmed text length
        let charCount = 0;
        const keptSections: string[] = [];
        for (let i = sectionTexts.length - 1; i >= 0; i--) {
          charCount += sectionTexts[i].length + 1;
          if (charCount > analysisText.length * 1.1) break;
          keptSections.unshift(sectionTexts[i]);
        }
        sectionTexts = keptSections.length > 0 ? keptSections : [analysisText];
      }
    } catch (_) {
      const charLimit = state.config.tokenWindow * 4;
      if (fullText.length > charLimit) {
        analysisText = fullText.slice(-charLimit);
        sectionTexts = [analysisText];
      }
    }
  }

  if (!force && analysisText === state.lastAnalyzedText) {
    // Text unchanged — still re-run the general coach for a fresh observation,
    // but skip the zero-cost regex passes (flags won't have changed)
    if (includeGeneralCoach && state.config.enableAutoCoaching && state.config.enableGeneralCoach) {
      state.autoGeneral = await coachGeneral(analysisText);
      await updatePanel();
    }
    return;
  }
  state.lastAnalyzedText = analysisText;
  const analysisStart = findAnalysisStart(fullText, analysisText);
  const sdtInitialInQuote = countQuoteChars(fullText.slice(0, analysisStart)) % 2 === 1;

  // Clear any open inline coaching from the previous generation's flags
  resetFlagCoachState();

  // Zero-cost regex passes — isolate each detector so one runtime issue does not
  // kill the entire refresh flow.
  try {
    state.autoSdtFlags = state.config.enableSdtDetection
      ? detectSdtFlags(analysisText, sectionTexts, sdtInitialInQuote, fullText, analysisStart)
      : [];
  } catch (e) {
    state.autoSdtFlags = [];
    api.v1.error('SDT detection error:', e);
  }

  try {
    state.autoTagFlags = state.config.enableTagDetection
      ? detectTagFlags(analysisText, sectionTexts, sdtInitialInQuote, fullText, analysisStart)
      : [];
  } catch (e) {
    state.autoTagFlags = [];
    api.v1.error('Tag detection error:', e);
  }

  try {
    state.autoAdverbFlags = state.config.enableAdverbDetection
      ? detectAdverbFlags(analysisText, sectionTexts, sdtInitialInQuote, fullText, analysisStart)
      : [];
  } catch (e) {
    state.autoAdverbFlags = [];
    api.v1.error('Adverb detection error:', e);
  }

  try {
    state.autoPassiveFlags = state.config.enablePassiveDetection
      ? detectPassiveFlags(analysisText, sectionTexts, sdtInitialInQuote, fullText, analysisStart)
      : [];
  } catch (e) {
    state.autoPassiveFlags = [];
    api.v1.error('Passive detection error:', e);
  }

  await runAutoReplaceSdtFlags();

  // Lightweight general coach (single low-token AI call)
  if (includeGeneralCoach && state.config.enableAutoCoaching && state.config.enableGeneralCoach) {
    state.autoGeneral = await coachGeneral(analysisText);
  }

  await updatePanel();
}

async function runAutoReplaceSdtFlags(): Promise<void> {
  if (!state.config.enableAutoReplace || state.isAutoReplacing) return;

  const sdtItems = state.config.enableSdtDetection
    ? state.autoSdtFlags
        .filter(flag => getConfidence(flag.score) !== 'low')
        .map(flag => ({ kind: 'sdt' as const, flag, score: flag.score }))
    : [];
  const adverbItems = state.config.enableAdverbDetection
    ? state.autoAdverbFlags
        .filter(flag => getConfidence(flag.score) !== 'low')
        .map(flag => ({ kind: 'adverb' as const, flag, score: flag.score }))
    : [];
  const itemsToReplace = [...sdtItems, ...adverbItems]
    .sort((a, b) => b.score - a.score)
    .slice(0, 5);
  if (itemsToReplace.length === 0) return;

  const hasPermission = await api.v1.permissions.has('documentEdit');
  if (!hasPermission) {
    const granted = await api.v1.permissions.request(
      'documentEdit',
      "Prose Coach needs permission to edit the document in order to auto-replace prose flags."
    );
    if (!granted) {
      api.v1.ui.toast('Auto replace skipped - document edit permission denied', { type: 'warning' });
      return;
    }
  }

  state.isAutoReplacing = true;
  await updatePanel();

  let replacedCount = 0;
  try {
    for (const item of itemsToReplace) {
      const quotaReady = await waitForAutoReplaceQuota(item);
      if (!quotaReady) break;

      const feedback = item.kind === 'sdt'
        ? await coachSdt(item.flag.narration, item.flag.word, item.flag.type, item.flag.context)
        : await coachAdverb(item.flag.narration, item.flag.word, item.flag.context);
      const revision = extractRevisionText(feedback);
      if (!revision) continue;

      const replaced = await replaceSentenceInDocument(item.flag.narration, revision, item.flag.narration, false);
      if (replaced) replacedCount++;
    }

    if (replacedCount > 0) {
      state.autoSdtFlags = [];
      state.autoAdverbFlags = [];
      state.lastAnalyzedText = '';
      api.v1.ui.toast(`Auto replaced ${replacedCount} prose flag${replacedCount === 1 ? '' : 's'}`, { type: 'success' });
    }
  } catch (e) {
    api.v1.error('Auto replace error:', e);
    api.v1.ui.toast('Auto replace error - check script log', { type: 'error' });
  } finally {
    state.isAutoReplacing = false;
  }
}

async function waitForAutoReplaceQuota(item: { kind: 'sdt'; flag: SdtFlag } | { kind: 'adverb'; flag: AdverbFlag }): Promise<boolean> {
  const outputTokensNeeded = 320;
  let inputTokensNeeded = 800;

  try {
    let prompt = '';
    if (item.kind === 'sdt') {
      const basePrompt = item.flag.type === 'reaction_tell' ? state.config.reactionPrompt : state.config.sdtPrompt;
      const ban = `\n\nIMPORTANT: The revision must NOT contain the word "${item.flag.word}" or any of its forms. Find a way to show the same thing without using that word at all.`;
      prompt = `${basePrompt}${ban}\n\n${buildTargetContextBlock(item.flag.narration, item.flag.context)}`;
    } else {
      prompt = `You are a surgical prose coach. The target narration sentence uses the adverb "${item.flag.word}". Use the local context to understand meaning, but give one revised sentence for the target only. Explain what the adverb is trying to add, then strengthen the verb or action so the adverb is unnecessary. Preserve meaning, POV, and tone. Be direct and surgical — no preamble. Format: ISSUE: [adverb and what it is doing] | REVISION: [rewrite]\n\n${buildTargetContextBlock(item.flag.narration, item.flag.context)}`;
    }
    inputTokensNeeded = Math.max(
      200,
      await api.v1.script.countUncachedInputTokens([{ role: 'user', content: prompt }], 'glm-4-6')
    );
  } catch (_) {
    inputTokensNeeded = 800;
  }

  const allowedInput = api.v1.script.getAllowedInput();
  const allowedOutput = api.v1.script.getAllowedOutput();
  if (allowedInput >= inputTokensNeeded && allowedOutput >= outputTokensNeeded) {
    return true;
  }

  const inputWait = api.v1.script.getTimeUntilAllowedInput(inputTokensNeeded);
  const outputWait = api.v1.script.getTimeUntilAllowedOutput(outputTokensNeeded);
  const waitMs = Math.max(inputWait, outputWait);
  const waitSeconds = Math.max(1, Math.ceil(waitMs / 1000));
  api.v1.ui.toast(`Auto replace waiting for quota (${waitSeconds}s)`, { type: 'info' });

  if (allowedInput < inputTokensNeeded) {
    await api.v1.script.waitForAllowedInput(inputTokensNeeded);
  }
  if (allowedOutput < outputTokensNeeded) {
    await api.v1.script.waitForAllowedOutput(outputTokensNeeded);
  }

  await loadConfig();
  return state.config.enableAutoReplace;
}

// ============================================================================
// CONTEXT MENU COACHING ACTIONS
// ============================================================================

async function runContextMenuCoach(
  selection: DocumentSelection,
  mode: 'sdt' | 'tag' | 'general'
): Promise<void> {
  if (state.isCoaching) {
    api.v1.ui.toast('Already coaching — please wait', { type: 'warning' });
    return;
  }

  // Extract selected text
  const sections = await api.v1.document.scan();

  // Find from/to positions by array index, not sectionId comparison —
  // sectionIds are arbitrary integers, not guaranteed sequential
  const fromIdx = sections.findIndex(s => s.sectionId === selection.from.sectionId);
  const toIdx = sections.findIndex(s => s.sectionId === selection.to.sectionId);

  let passage = '';

  if (fromIdx === -1 || toIdx === -1) {
    api.v1.ui.toast('Could not locate selection in document', { type: 'warning' });
    return;
  }

  for (let i = fromIdx; i <= toIdx; i++) {
    const { sectionId, section } = sections[i];
    const sText = section.text;
    if (i === fromIdx && i === toIdx) {
      passage = sText.substring(selection.from.offset, selection.to.offset);
    } else if (i === fromIdx) {
      passage = sText.substring(selection.from.offset);
    } else if (i === toIdx) {
      passage += '\n' + sText.substring(0, selection.to.offset);
    } else {
      passage += '\n' + sText;
    }
  }

  passage = passage.trim();

  if (passage.length < 20) {
    api.v1.ui.toast('Please select more text to coach (at least a sentence or two)', { type: 'warning' });
    return;
  }

  state.isCoaching = true;
  await updatePanel();

  const modeLabel = mode === 'sdt' ? '👁 Show-Don\'t-Tell' :
                    mode === 'tag' ? '🏷 Action Tag' : '💬 General';

  api.v1.ui.toast(`${modeLabel} coaching in progress...`, { type: 'info' });

  try {
    let feedback = '';

    if (mode === 'sdt') {
      feedback = await coachSdt(passage, undefined, 'selection');
    } else if (mode === 'tag') {
      feedback = await coachTags(passage);
    } else {
      feedback = await coachGeneral(passage);
    }

    if (feedback) {
      const entry: CoachEntry = {
        id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
        timestamp: Date.now(),
        mode,
        text: passage.length > 80 ? passage.substring(0, 80) + '...' : passage,
        passage,
        feedback
      };

      state.feed.unshift(entry);
      if (state.feed.length > 20) state.feed.pop();

      await updatePanel();
      api.v1.ui.toast(`${modeLabel} coaching ready — see sidebar`, { type: 'success' });
    }
  } catch (e) {
    api.v1.error('Coach error:', e);
    api.v1.ui.toast('Coaching error — check script log', { type: 'error' });
  } finally {
    state.isCoaching = false;
    await updatePanel();
  }
}

// ============================================================================
// INLINE FLAG COACHING — lazy fetch, cached, toggled by clicking the flag card
// ============================================================================

/**
 * Called when the user clicks a flag card in the sidebar.
 * First click: fetches surgical coaching for that sentence, caches it, expands.
 * Subsequent clicks: just toggle expand/collapse (no new AI call).
 */
async function runInlineCoaching(
  key: string,
  fetcher: () => Promise<string>,
  errorLabel: string
): Promise<void> {
  if (state.fetchingFlagKey !== null) {
    api.v1.ui.toast('Already fetching coaching - please wait', { type: 'warning' });
    return;
  }

  state.fetchingFlagKey = key;
  state.expandedFlags.add(key);
  await updatePanel();

  try {
    const feedback = await fetcher();
    state.flagCoachCache.set(key, feedback || '(No coaching generated)');
  } catch (e) {
    api.v1.error(`${errorLabel} error:`, e);
    state.flagCoachCache.set(key, '(Error - check script log)');
  } finally {
    state.fetchingFlagKey = null;
    await updatePanel();
  }
}

async function toggleFlagCoaching(
  key: string,
  sentence: string,
  mode: 'sdt' | 'tag' | 'adverb' | 'passive',
  triggerWord?: string,
  flagType?: string,
  context?: string
): Promise<void> {
  // If already expanded, just collapse
  if (state.expandedFlags.has(key)) {
    state.expandedFlags.delete(key);
    await updatePanel();
    return;
  }

  // If result already cached, just expand
  if (state.flagCoachCache.has(key)) {
    state.expandedFlags.add(key);
    await updatePanel();
    return;
  }

  await runInlineCoaching(key, async () => {
    if (mode === 'sdt') return coachSdt(sentence, triggerWord, flagType, context);
    if (mode === 'adverb') return coachAdverb(sentence, triggerWord || 'adverb', context);
    if (mode === 'passive') return coachPassive(sentence, triggerWord || 'passive phrasing', context);
    return coachTags(sentence);
  }, 'Inline flag coach');
}

async function toggleGeneralRevisionCoaching(key: string, generalLine: string): Promise<void> {
  if (/^Nothing stands out\.?$/i.test(generalLine.trim())) {
    api.v1.ui.toast('General Coach did not flag a specific sentence this time', { type: 'info' });
    return;
  }

  if (state.expandedFlags.has(key)) {
    state.expandedFlags.delete(key);
    await updatePanel();
    return;
  }

  if (state.flagCoachCache.has(key)) {
    state.expandedFlags.add(key);
    await updatePanel();
    return;
  }

  await runInlineCoaching(
    key,
    () => coachGeneralRevision(generalLine, state.lastAnalyzedText || generalLine),
    'Inline general revision coach'
  );
}


async function toggleSdtClusterCoaching(
  key: string,
  passage: string,
  words: string[],
  flagType: string
): Promise<void> {
  if (state.expandedFlags.has(key)) {
    state.expandedFlags.delete(key);
    await updatePanel();
    return;
  }

  if (state.flagCoachCache.has(key)) {
    state.expandedFlags.add(key);
    await updatePanel();
    return;
  }

  await runInlineCoaching(
    key,
    () => coachSdtCluster(passage, words, flagType),
    'Inline cluster coach'
  );
}

async function retryInlineCoaching(key: string, fetcher: () => Promise<string>): Promise<void> {
  await runInlineCoaching(key, fetcher, 'Inline retry coach');
}

/**
 * Clear all inline coaching state when flags are refreshed after a new generation.
 * Keeps the cache small and prevents stale coaching from showing on new text.
 */
function resetFlagCoachState(): void {
  state.expandedFlags.clear();
  state.flagCoachCache.clear();
  state.fetchingFlagKey = null;
}


function getConfidence(score: number): string {
  if (score >= 3) return 'high';
  if (score >= 2) return 'medium';
  return 'low';
}

function getConfidenceColor(confidence: string): string {
  if (confidence === 'high') return '#cc4444';
  if (confidence === 'medium') return '#e6aa44';
  return '#6688aa';
}

function getDominantSdtCluster(flags: SdtFlag[]): { type: string; flags: SdtFlag[]; words: string[]; score: number; confidence: string; label: string; passage: string } | null {
  const source = state.lastAnalyzedText || '';
  const groups = new Map<string, SdtFlag[]>();
  for (const flag of flags) {
    const group = groups.get(flag.type) ?? [];
    group.push(flag);
    groups.set(flag.type, group);
  }

  let bestType: string | null = null;
  let bestFlags: SdtFlag[] = [];
  let bestScore = 0;

  // Do not cluster every same-type flag across the whole analysis window.
  // Cluster only nearby flags, or the paragraph-level rewrite prompt can swallow
  // an entire scene. This keeps the fix local and surgical.
  groups.forEach((group, type) => {
    if (group.length < 2) return;

    const positioned = getPositionedFlags(group)
      .filter(item => item.index >= 0)
      .sort((a, b) => a.index - b.index);

    const candidateClusters: SdtFlag[][] = [];

    if (positioned.length >= 2) {
      let current: { flag: SdtFlag; index: number; end: number }[] = [positioned[0]];
      for (let i = 1; i < positioned.length; i++) {
        const prev = current[current.length - 1];
        const next = positioned[i];
        const gap = next.index - prev.end;
        const crossesLineBreak = /\r|\n/.test(source.slice(prev.end, next.index));
        if (!crossesLineBreak && gap <= 420) {
          current.push(next);
        } else {
          if (current.length >= 2) candidateClusters.push(current.map(item => item.flag));
          current = [next];
        }
      }
      if (current.length >= 2) candidateClusters.push(current.map(item => item.flag));
    }

    for (const cluster of candidateClusters) {
      const groupScore = cluster.reduce((sum, flag) => sum + flag.score, 0);
      if (groupScore > bestScore) {
        bestScore = groupScore;
        bestType = type;
        bestFlags = cluster.slice().sort((a, b) => b.score - a.score);
      }
    }
  });

  if (!bestType || bestFlags.length < 2) return null;

  const words = Array.from(new Set(bestFlags.map(flag => flag.word)));
  const maxScore = Math.max(...bestFlags.map(flag => flag.score));
  const confidence = getConfidence(maxScore);
  const label = bestType === 'filter_verb' ? 'Internal filtering cluster' :
                bestType === 'reaction_tell' ? 'Reaction tell cluster' :
                'Telling-word cluster';
  const passage = buildSdtClusterPassage(bestFlags);

  return { type: bestType, flags: bestFlags, words, score: maxScore, confidence, label, passage };
}

function getPositionedFlags(flags: SdtFlag[]): { flag: SdtFlag; index: number; end: number }[] {
  const source = state.lastAnalyzedText || '';
  return flags.map(flag => {
    let idx = source.indexOf(flag.sentence);
    let needle = flag.sentence;
    if (idx === -1) {
      idx = source.indexOf(flag.narration);
      needle = flag.narration;
    }
    return { flag, index: idx, end: idx === -1 ? -1 : idx + needle.length };
  });
}

function buildSdtClusterPassage(flags: SdtFlag[]): string {
  const source = state.lastAnalyzedText || '';
  const positioned = getPositionedFlags(flags)
    .filter(item => item.index >= 0)
    .sort((a, b) => a.index - b.index);

  // Primary behavior: rewrite the flagged sentence cluster only.
  // Add a tiny amount of sentence-boundary context, then hard-cap the size.
  if (positioned.length > 0) {
    let start = positioned[0].index;
    let end = positioned[positioned.length - 1].end;

    // Pull to nearby sentence boundaries, not arbitrary 260-char padding.
    const before = source.slice(0, start);
    const after = source.slice(end);
    const prevLineBreak = Math.max(before.lastIndexOf('\n'), before.lastIndexOf('\r'));
    const prevBoundary = Math.max(before.lastIndexOf('. '), before.lastIndexOf('! '), before.lastIndexOf('? '), prevLineBreak);
    const nextCandidates = [
      after.indexOf('. '),
      after.indexOf('! '),
      after.indexOf('? '),
      ...[after.indexOf('\n'), after.indexOf('\r')]
    ].filter(idx => idx >= 0);
    const nextBoundary = nextCandidates.length > 0 ? Math.min(...nextCandidates) : -1;

    if (prevLineBreak !== -1 && prevLineBreak > prevBoundary - 2) {
      start = prevLineBreak + 1;
    } else if (prevBoundary !== -1 && start - prevBoundary <= 180) {
      start = prevBoundary + 1;
    }
    const nextLineBreakCandidates = [after.indexOf('\n'), after.indexOf('\r')].filter(index => index >= 0);
    const nextLineBreak = nextLineBreakCandidates.length > 0 ? Math.min(...nextLineBreakCandidates) : -1;
    if (nextLineBreak !== -1 && (nextBoundary === -1 || nextLineBreak <= nextBoundary)) {
      end = end + nextLineBreak;
    } else if (nextBoundary !== -1 && nextBoundary <= 180) {
      end = end + nextBoundary + 1;
    }

    let passage = source.slice(start, end).trim();

    // Hard stop: cluster coaching should never feed a whole scene.
    // If still too large, use just the flagged sentences.
    if (passage.length > 950) {
      passage = positioned.map(item => item.flag.sentence).join(' ').trim();
    }

    if (passage.length > 950) {
      passage = passage.slice(0, 950).replace(/\s+\S*$/, '').trim();
    }

    return passage;
  }

  return flags[0]?.sentence ?? '';
}

// ============================================================================
// UI — PANEL CONTENT
// ============================================================================

/**
 * Diff originalText against revisionText at word level using LCS.
 * Returns an array of spans: { text, isNew } where isNew=true means the words
 * are novel (should be tagged 'ai') and isNew=false means they match the original
 * (should carry no origin tag, i.e. treated as user-generated).
 */
function diffRevisionSpans(originalText: string, revisionText: string): { text: string; isNew: boolean }[] {
  // Tokenize into words+whitespace so we can reconstruct the string exactly.
  // Each token is either a word (letters/digits/punctuation run) or whitespace.
  const tokenize = (s: string): string[] => s.match(/\S+|\s+/g) ?? [];
  const origTokens = tokenize(originalText);
  const revTokens = tokenize(revisionText);

  // LCS on lowercased word tokens (ignore whitespace tokens for matching)
  const origWords = origTokens.filter(t => /\S/.test(t)).map(t => t.toLowerCase());
  const revWords  = revTokens.filter(t => /\S/.test(t)).map(t => t.toLowerCase());
  const m = origWords.length, n = revWords.length;

  // Build LCS table
  const dp: number[][] = Array.from({ length: m + 1 }, () => new Array(n + 1).fill(0));
  for (let i = 1; i <= m; i++) {
    for (let j = 1; j <= n; j++) {
      dp[i][j] = origWords[i - 1] === revWords[j - 1]
        ? dp[i - 1][j - 1] + 1
        : Math.max(dp[i - 1][j], dp[i][j - 1]);
    }
  }

  // Backtrack to find which revision word indices are matched
  const matchedRevIdx = new Set<number>();
  let i = m, j = n;
  while (i > 0 && j > 0) {
    if (origWords[i - 1] === revWords[j - 1]) {
      matchedRevIdx.add(j - 1); i--; j--;
    } else if (dp[i - 1][j] >= dp[i][j - 1]) {
      i--;
    } else {
      j--;
    }
  }

  // Walk revTokens and emit spans, grouping consecutive same-isNew tokens
  const spans: { text: string; isNew: boolean }[] = [];
  let revWordIdx = 0;
  for (const token of revTokens) {
    const isWord = /\S/.test(token);
    const isNew = isWord ? !matchedRevIdx.has(revWordIdx) : false; // whitespace inherits next word's status below
    if (isWord) revWordIdx++;

    if (spans.length > 0 && spans[spans.length - 1].isNew === isNew) {
      spans[spans.length - 1].text += token;
    } else {
      spans.push({ text: token, isNew });
    }
  }

  // Merge leading/trailing whitespace into adjacent spans so we don't emit
  // tiny whitespace-only spans with wrong isNew flags
  return spans.filter(s => s.text.length > 0);
}

function isRangeFullyAiOrigin(
  origin: { position: number; length: number; data: string }[],
  text: string,
  start: number,
  length: number
): boolean {
  if (length <= 0) return false;

  const end = start + length;
  let checkedAnyNonWhitespace = false;

  for (let pos = start; pos < end && pos < text.length; pos++) {
    if (/\s/.test(text[pos])) continue;
    checkedAnyNonWhitespace = true;

    const coveredByAi = origin.some(seg =>
      seg.data === 'ai' &&
      pos >= seg.position &&
      pos < seg.position + seg.length
    );

    if (!coveredByAi) return false;
  }

  return checkedAnyNonWhitespace;
}

function extractRevisionText(feedback: string): string | null {
  const match = feedback.match(/REVISION:\s*(.+)/i);
  return match ? match[1].trim() : null;
}

const stripBBCode = (text: string): string => text.replace(/\[[^\]]*\]/g, '');
const normalizeQuotes = (text: string): string => text.replace(/[\u201C\u201D\u2018\u2019]/g, '"');

async function replaceSentenceInDocument(
  targetSentence: string,
  revisionText: string,
  originalPassage?: string,
  showToast: boolean = true
): Promise<boolean> {
  const needle = targetSentence.trim();
  const needlePlain = stripBBCode(needle);
  const needlePlainNorm = normalizeQuotes(needlePlain);

  let targetSectionId: number | null = null;
  let updatedText: string | null = null;
  let replacedLength = needle.length;

  const sections = await api.v1.document.scan();
  const passagePlainNorm = originalPassage
    ? normalizeQuotes(stripBBCode(originalPassage.trim()))
    : null;
  const candidateSections = passagePlainNorm
    ? sections.filter(({ section }) => normalizeQuotes(stripBBCode(section.text)).includes(passagePlainNorm))
    : sections;
  const searchSections = candidateSections.length > 0 ? candidateSections : sections;

  for (const { sectionId, section } of searchSections) {
    const sText = section.text;
    if (sText.includes(needle)) {
      targetSectionId = sectionId;
      updatedText = sText.replace(needle, revisionText);
      break;
    }

    const sPlain = stripBBCode(sText);
    const sPlainNorm = normalizeQuotes(sPlain);
    const plainIdx = sPlainNorm.indexOf(needlePlainNorm);
    if (plainIdx !== -1) {
      targetSectionId = sectionId;

      let plainPos = 0;
      let taggedStart = 0;
      let inTag = false;
      for (let ci = 0; ci < sText.length; ci++) {
        if (sText[ci] === '[') inTag = true;
        if (!inTag) {
          if (plainPos === plainIdx) { taggedStart = ci; break; }
          plainPos++;
        }
        if (sText[ci] === ']') inTag = false;
      }

      let plainConsumed = 0;
      let taggedEnd = taggedStart;
      inTag = false;
      for (let ci = taggedStart; ci < sText.length && plainConsumed < needlePlain.length; ci++) {
        if (sText[ci] === '[') inTag = true;
        if (!inTag) plainConsumed++;
        if (sText[ci] === ']') inTag = false;
        taggedEnd = ci + 1;
      }

      updatedText = sText.slice(0, taggedStart) + revisionText + sText.slice(taggedEnd);
      replacedLength = taggedEnd - taggedStart;
      break;
    }
  }

  if (targetSectionId === null || updatedText === null) {
    if (showToast) {
      api.v1.ui.toast('Original sentence not found in document — use Copy to apply manually', { type: 'warning' });
      await api.v1.ui.modal.open({
        title: 'Sentence Not Found',
        size: 'small',
        content: [
          {
            type: 'text',
            text: 'The original sentence could not be located verbatim in the document (it may have been edited or is narration-stripped). Copy the revision below and paste it manually:',
            style: { fontSize: '0.85em', opacity: 0.7, marginBottom: '8px' }
          },
          {
            type: 'multilineTextInput',
            initialValue: revisionText,
            style: { width: '100%', fontStyle: 'italic' }
          }
        ]
      });
    }
    return false;
  }

  try {
    const replacementStart = (updatedText as string).indexOf(revisionText);
    const replacementEnd = replacementStart + revisionText.length;
    const lengthDelta = revisionText.length - replacedLength;

    const freshSections = await api.v1.document.scan();
    const freshSection = freshSections.find(s => s.sectionId === targetSectionId);
    const existingOrigin = freshSection?.section.origin ?? [];
    const newOrigin: { position: number; length: number; data: string }[] = [];

    for (const seg of existingOrigin) {
      const segEnd = seg.position + seg.length;
      if (segEnd <= replacementStart) {
        newOrigin.push({ ...seg });
      } else if (seg.position >= replacementStart + replacedLength) {
        newOrigin.push({ ...seg, position: seg.position + lengthDelta });
      } else {
        if (seg.position < replacementStart) {
          newOrigin.push({ position: seg.position, length: replacementStart - seg.position, data: seg.data });
        }
        const afterStart = replacementStart + replacedLength;
        if (segEnd > afterStart) {
          newOrigin.push({ position: replacementEnd, length: segEnd - afterStart, data: seg.data });
        }
      }
    }

    const originalSentenceText = stripBBCode(needle);
    const originalSectionText = freshSection?.section.text ?? '';
    const replacedRangeWasAi = isRangeFullyAiOrigin(existingOrigin, originalSectionText, replacementStart, replacedLength);
    const revSpans = diffRevisionSpans(originalSentenceText, revisionText);
    let spanOffset = replacementStart;
    for (const span of revSpans) {
      if (replacedRangeWasAi || span.isNew) {
        newOrigin.push({ position: spanOffset, length: span.text.length, data: 'ai' });
      }
      spanOffset += span.text.length;
    }

    newOrigin.sort((a, b) => a.position - b.position);
    await api.v1.document.updateParagraph(targetSectionId as number, { text: updatedText as string, origin: newOrigin });
    if (showToast) api.v1.ui.toast('Sentence replaced', { type: 'success' });
    return true;
  } catch (e) {
    api.v1.error('Replace in doc error:', e);
    if (showToast) api.v1.ui.toast('Could not update document - check script log', { type: 'error' });
    return false;
  }
}

/**
 * Render coaching result lines, adding a 📋 Copy button and ✏️ Replace button after any REVISION: line.
 * originalSentence: the narration/sentence text that was flagged — used to locate it in the document for replacement.
 */
function buildCoachingResultItems(
  cachedResult: string,
  originalSentence?: string,
  retryCallback?: () => Promise<void>
): any[] {
  const items: any[] = [];
  const lines = cachedResult.split('\n').filter((l: string) => l.trim());

  // Helper to extract and clean a sentence from a SENTENCE:/TARGET: line.
  // The model formats output as one pipe-separated line: "SENTENCE: [text] | ISSUE: ... | REVISION: ..."
  // so we truncate at the first ' |' separator, then conditionally strip wrapping quotes.
  const extractSentence = (raw: string): string => {
    const pipeIdx = raw.indexOf(' |');
    const extracted = (pipeIdx !== -1 ? raw.slice(0, pipeIdx) : raw).trim();
    // Only strip surrounding quotes if they form a matched wrapper pair with no internal close quote.
    const OPEN_QUOTES = new Set(['"', '\u201C']);
    const CLOSE_QUOTES = new Set(['"', '\u201D']);
    const first = extracted[0];
    const last = extracted[extracted.length - 1];
    const isWrapped = first && last &&
                      OPEN_QUOTES.has(first) && CLOSE_QUOTES.has(last) &&
                      extracted.slice(1, -1).indexOf(last) === -1;
    return isWrapped ? extracted.slice(1, -1).trim() : extracted;
  };

  // Seed with originalSentence if it looks like a single sentence — used as fallback
  // when the output has a REVISION: with no preceding SENTENCE: on the same result.
  const seedTarget = originalSentence?.trim();

  // currentTargetSentence tracks the most recently seen SENTENCE:/TARGET: as we walk lines,
  // so each REVISION: button closes over the sentence that immediately precedes it.
  let currentTargetSentence: string | undefined = seedTarget;

  let hasRevision = false;
  lines.forEach((line: string) => {
    // Update the running sentence target whenever we hit a SENTENCE:/TARGET: line
    const targetMatch = line.match(/(?:TARGET|SENTENCE):\s*(.+)/i);
    if (targetMatch) {
      currentTargetSentence = extractSentence(targetMatch[1]);
    }
    items.push({
      type: 'text',
      text: line,
      style: { fontSize: '0.82em', marginTop: '4px', paddingLeft: '4px' }
    });
    const revisionMatch = line.match(/REVISION:\s*(.+)/i);
    if (revisionMatch) {
      hasRevision = true;
      const revisionText = revisionMatch[1].trim();
      // Capture the sentence target at the moment this REVISION: is encountered
      const targetForThisRevision = currentTargetSentence || originalSentence;
      items.push({
        type: 'row',
        spacing: 'start',
        content: [
          {
            type: 'button',
            text: '📋 Copy revision',
            style: { fontSize: '0.78em', marginTop: '2px', marginLeft: '4px', opacity: 0.8 },
            callback: async () => {
              await api.v1.ui.modal.open({
                title: 'Copy Revision',
                size: 'small',
                content: [
                  {
                    type: 'text',
                    text: 'Select and copy the revision text below:',
                    style: { fontSize: '0.85em', opacity: 0.7, marginBottom: '8px' }
                  },
                  {
                    type: 'multilineTextInput',
                    initialValue: revisionText,
                    style: { width: '100%', fontStyle: 'italic' }
                  }
                ]
              });
            }
          },
          ...(retryCallback ? [{
            type: 'button',
            text: '🔁 Retry prompt',
            style: { fontSize: '0.78em', marginTop: '2px', marginLeft: '4px', opacity: 0.8 },
            callback: async () => {
              await retryCallback();
            }
          }] : []),
          ...(targetForThisRevision ? [{
            type: 'button',
            text: '✏️ Replace in doc',
            style: { fontSize: '0.78em', marginTop: '2px', marginLeft: '4px', opacity: 0.8 },
            callback: async () => {
              await replaceSentenceInDocument(
                targetForThisRevision,
                revisionText,
                originalSentence
              );
            }
          }] : [])
        ]
      });
    }
  });

  if (retryCallback && !hasRevision) {
    items.push({
      type: 'row',
      spacing: 'start',
      content: [
        {
          type: 'button',
          text: '🔁 Retry prompt',
          style: { fontSize: '0.78em', marginTop: '4px', marginLeft: '4px', opacity: 0.8 },
          callback: async () => {
            await retryCallback();
          }
        }
      ]
    });
  }

  return items;
}

function buildPanelContent(): any[] {
  const content: any[] = [];

  // Header
  content.push({
    type: 'row',
    spacing: 'start',
    content: [
      {
        type: 'text',
        text: '**Prose Coach** — Click any flag below for inline coaching. Right-click selected text to coach any passage.',
        markdown: true,
        style: { marginBottom: '0' }
      },
      {
        type: 'row',
        spacing: 'start',
        content: [
          {
            type: 'button',
            text: state.config.enableAutoScan ? 'Auto Scan: On' : 'Auto Scan: Off',
            style: { fontSize: '0.85em', flexShrink: '0' },
            callback: async () => { await toggleAutoScan(); }
          },
          {
            type: 'button',
            text: state.isRefreshing ? 'Refreshing...' : 'Refresh',
            style: { fontSize: '0.85em', flexShrink: '0' },
            callback: async () => {
              await triggerManualRefresh();
            }
          }
        ]
      }
    ].slice(0, 1)
  });

  content.push({
    type: 'row',
    spacing: 'start',
    style: { flexWrap: 'wrap', gap: '4px' },
    content: [
      {
        type: 'button',
        text: state.config.enableAutoScan ? 'Auto Scan: On' : 'Auto Scan: Off',
        style: { fontSize: '0.85em', flexShrink: '0' },
        callback: async () => { await toggleAutoScan(); }
      },
      {
        type: 'button',
        text: state.config.enableAutoCoaching ? 'Auto Coaching: On' : 'Auto Coaching: Off',
        style: { fontSize: '0.85em', flexShrink: '0' },
        callback: async () => { await toggleAutoCoaching(); }
      },
      {
        type: 'button',
        text: state.config.enableAutoReplace ? 'Auto Replace: On' : 'Auto Replace: Off',
        style: { fontSize: '0.85em', flexShrink: '0' },
        callback: async () => { await toggleAutoReplace(); }
      },
      {
        type: 'button',
        text: state.isRefreshing ? 'Refreshing...' : 'Refresh',
        style: { fontSize: '0.85em', flexShrink: '0' },
        callback: async () => {
          await triggerManualRefresh();
        }
      }
    ]
  });

  if (state.isCoaching) {
    content.push({
      type: 'box',
      style: {
        backgroundColor: '#1a2a3a',
        padding: '8px',
        borderRadius: '4px',
        borderLeft: '3px solid #88aaff',
        marginBottom: '10px'
      },
      content: [{
        type: 'text',
        text: '⏳ Coaching in progress...',
        style: { fontSize: '0.9em' }
      }]
    });
  }

  if (state.isAutoReplacing) {
    content.push({
      type: 'box',
      style: {
        backgroundColor: '#2a2418',
        padding: '8px',
        borderRadius: '4px',
        borderLeft: '3px solid #e6aa44',
        marginBottom: '10px'
      },
      content: [{
        type: 'text',
        text: 'Auto replace in progress...',
        style: { fontSize: '0.9em' }
      }]
    });
  }

  // Auto-detection section (zero cost)
  const hasAutoFlags = state.autoSdtFlags.length > 0 || state.autoTagFlags.length > 0 || state.autoAdverbFlags.length > 0 || state.autoPassiveFlags.length > 0 || state.autoGeneral;

  if (hasAutoFlags) {
    const autoContent: any[] = [];

    // General one-liner
    if (state.config.enableAutoCoaching && state.autoGeneral) {
      // Split the three-sentence response: craft note | line to strengthen | story musing
      const generalLines = state.autoGeneral.split('\n').map((l: string) => l.trim()).filter(Boolean);
      const icons = ['💬', '🔍', '🌀'];
      const generalContent: any[] = [];
      generalLines.forEach((line: string, idx: number) => {
        if (idx > 0) {
          generalContent.push({ type: 'separator' });
        }
        if (idx === 1) {
          const key = 'general-strengthen';
          const isExpanded = state.expandedFlags.has(key);
          const isFetching = state.fetchingFlagKey === key;
          const cachedResult = state.flagCoachCache.get(key);
          const chevron = isExpanded ? 'v' : '>';
          const cardContent: any[] = [
            {
              type: 'button',
              text: `${chevron} ${icons[idx]} Line to strengthen`,
              style: {
                fontSize: '0.85em',
                textAlign: 'left',
                width: '100%',
                background: 'none',
                border: 'none',
                padding: '0',
                cursor: 'pointer',
                fontWeight: 'bold',
                opacity: isFetching ? 0.5 : 1
              },
              callback: async () => { await toggleGeneralRevisionCoaching(key, line); }
            },
            {
              type: 'button',
              text: line,
              style: {
                fontSize: '0.8em',
                opacity: 0.75,
                marginTop: '2px',
                textAlign: 'left',
                width: '100%',
                background: 'none',
                border: 'none',
                padding: '0',
                cursor: 'pointer'
              },
              callback: async () => { await toggleGeneralRevisionCoaching(key, line); }
            }
          ];

          if (isExpanded) {
            if (isFetching) {
              cardContent.push({
                type: 'text',
                text: 'Loading revision...',
                style: { fontSize: '0.82em', opacity: 0.7, marginTop: '6px', paddingLeft: '4px' }
              });
            } else if (cachedResult) {
              for (const item of buildCoachingResultItems(
                cachedResult,
                undefined,
                async () => { await retryInlineCoaching(key, async () => await coachGeneralRevision(line, state.lastAnalyzedText || line)); }
              )) {
                cardContent.push(item);
              }
            }
          }

          generalContent.push({
            type: 'box',
            style: {
              backgroundColor: 'bg1',
              padding: '6px 8px',
              borderRadius: '4px',
              marginTop: '4px',
              marginBottom: '4px',
              borderLeft: isExpanded ? '3px solid #aa88ff' : '3px solid #8866dd'
            },
            content: cardContent
          });
          return;
        }
        generalContent.push({
          type: 'text',
          text: `${icons[idx] ?? '•'} ${line}`,
          style: {
            fontSize: '0.88em',
            fontStyle: idx === 2 ? 'italic' : 'normal',
            opacity: idx === 2 ? 0.75 : 1,
            marginTop: '4px',
            marginBottom: '4px'
          }
        });
      });
      autoContent.push({
        type: 'box',
        style: {
          backgroundColor: 'bg1',
          padding: '8px',
          borderRadius: '4px',
          marginBottom: '6px',
          borderLeft: '3px solid #aa88ff'
        },
        content: generalContent
      });
    }

    // SDT flags
    if (state.autoSdtFlags.length > 0) {
      const flagLabel = state.autoSdtFlags.length === 1 ? '1 telling moment' : `${state.autoSdtFlags.length} telling moments`;
      autoContent.push({
        type: 'text',
        text: `**👁 Show-Don't-Tell** — ${flagLabel} detected:`,
        markdown: true,
        style: { fontSize: '0.9em', marginTop: '4px', marginBottom: '4px' }
      });

      const sdtCluster = getDominantSdtCluster(state.autoSdtFlags);
      if (sdtCluster) {
        const key = 'sdt-cluster';
        const isExpanded = state.expandedFlags.has(key);
        const isFetching = state.fetchingFlagKey === key;
        const cachedResult = state.flagCoachCache.get(key);
        const chevron = isExpanded ? 'v' : '>';
        const color = getConfidenceColor(sdtCluster.confidence);
        const wordList = sdtCluster.words.join(', ');
        const preview = sdtCluster.passage.length > 130 ? sdtCluster.passage.substring(0, 130) + '...' : sdtCluster.passage;
        const cardContent: any[] = [
          {
            type: 'button',
            text: `${chevron} 🔧 ${sdtCluster.label} (${sdtCluster.confidence})`,
            style: {
              fontSize: '0.85em',
              textAlign: 'left',
              width: '100%',
              background: 'none',
              border: 'none',
              padding: '0',
              cursor: 'pointer',
              fontWeight: 'bold',
              opacity: isFetching ? 0.5 : 1
            },
            callback: async () => { await toggleSdtClusterCoaching(key, sdtCluster.passage, sdtCluster.words, sdtCluster.type); }
          },
          {
            type: 'button',
            text: `Pattern words: ${wordList}`,
            style: {
              fontSize: '0.8em',
              opacity: 0.8,
              marginTop: '2px',
              textAlign: 'left',
              width: '100%',
              background: 'none',
              border: 'none',
              padding: '0',
              cursor: 'pointer'
            },
            callback: async () => { await toggleSdtClusterCoaching(key, sdtCluster.passage, sdtCluster.words, sdtCluster.type); }
          },
          {
            type: 'button',
            text: preview,
            style: {
              fontSize: '0.8em',
              opacity: 0.65,
              marginTop: '2px',
              fontStyle: 'italic',
              textAlign: 'left',
              width: '100%',
              background: 'none',
              border: 'none',
              padding: '0',
              cursor: 'pointer'
            },
            callback: async () => { await toggleSdtClusterCoaching(key, sdtCluster.passage, sdtCluster.words, sdtCluster.type); }
          }
        ];

        if (isExpanded) {
          if (isFetching) {
            cardContent.push({
              type: 'text',
              text: '⏳ Fetching cluster coaching...',
              style: { fontSize: '0.82em', opacity: 0.7, marginTop: '6px', paddingLeft: '4px' }
            });
          } else if (cachedResult) {
            for (const item of buildCoachingResultItems(
              cachedResult,
              undefined,
              async () => { await retryInlineCoaching(key, async () => await coachSdtCluster(sdtCluster.passage, sdtCluster.words, sdtCluster.type)); }
            )) {
              cardContent.push(item);
            }
          }
        }

        autoContent.push({
          type: 'box',
          style: {
            backgroundColor: 'bg1',
            padding: '6px 8px',
            borderRadius: '4px',
            marginBottom: '6px',
            borderLeft: `3px solid ${color}`,
            cursor: 'pointer'
          },
          content: cardContent
        });
      }

      const sdtRemainingFlags = sdtCluster
        ? state.autoSdtFlags.filter(flag => flag.type !== sdtCluster.type)
        : state.autoSdtFlags;
      const visibleSdtFlags = sdtRemainingFlags.filter(flag => getConfidence(flag.score) !== 'low');
      const displayedSdtFlags = (visibleSdtFlags.length > 0 ? visibleSdtFlags : sdtRemainingFlags).slice(0, 3);

      displayedSdtFlags.forEach((flag, i) => {
        const key = `sdt-${i}`;
        const icon = flag.type === 'filter_verb' ? '🔭' : flag.type === 'reaction_tell' ? '⚡' : '📢';
        const label = flag.type === 'filter_verb' ? 'filter verb' : flag.type === 'reaction_tell' ? 'reaction tell' : 'telling word';
        const confidence = getConfidence(flag.score);
        const color = getConfidenceColor(confidence);
        const truncated = flag.sentence.length > 100 ? flag.sentence.substring(0, 100) + '...' : flag.sentence;
        const isExpanded = state.expandedFlags.has(key);
        const isFetching = state.fetchingFlagKey === key;
        const cachedResult = state.flagCoachCache.get(key);
        const chevron = isExpanded ? 'v' : '>';

        const cardContent: any[] = [
          // Entire header row is a button spanning full width
          {
            type: 'button',
            text: `${chevron} ${icon} ${flag.word} (${label}, ${confidence})`,
            style: {
              fontSize: '0.85em',
              textAlign: 'left',
              width: '100%',
              background: 'none',
              border: 'none',
              padding: '0',
              cursor: 'pointer',
              fontWeight: 'bold',
              opacity: isFetching ? 0.5 : 1
            },
            callback: async () => { await toggleFlagCoaching(key, flag.narration, 'sdt', flag.word, flag.type, flag.context); }
          },
          // Sentence — also a button so clicking it triggers coaching too
          {
            type: 'button',
            text: truncated,
            style: {
              fontSize: '0.8em',
              opacity: 0.75,
              marginTop: '2px',
              fontStyle: 'italic',
              textAlign: 'left',
              width: '100%',
              background: 'none',
              border: 'none',
              padding: '0',
              cursor: 'pointer'
            },
            callback: async () => { await toggleFlagCoaching(key, flag.narration, 'sdt', flag.word, flag.type, flag.context); }
          }
        ];

        if (isExpanded) {
          if (isFetching) {
            cardContent.push({
              type: 'text',
              text: '⏳ Fetching coaching...',
              style: { fontSize: '0.82em', opacity: 0.7, marginTop: '6px', paddingLeft: '4px' }
            });
          } else if (cachedResult) {
            for (const item of buildCoachingResultItems(
              cachedResult,
              flag.narration,
              async () => { await retryInlineCoaching(key, async () => await coachSdt(flag.narration, flag.word, flag.type, flag.context)); }
            )) {
              cardContent.push(item);
            }
          }
        }

        autoContent.push({
          type: 'box',
          style: {
            backgroundColor: 'bg1',
            padding: '6px 8px',
            borderRadius: '4px',
            marginBottom: '4px',
            borderLeft: `3px solid ${color}`,
            cursor: 'pointer'
          },
          content: cardContent
        });
      });
    }

    // Adverb flags
    if (state.autoAdverbFlags.length > 0) {
      const flagLabel = state.autoAdverbFlags.length === 1 ? '1 adverb' : `${state.autoAdverbFlags.length} adverbs`;
      autoContent.push({
        type: 'text',
        text: `**Adverbs** - ${flagLabel} flagged:`,
        markdown: true,
        style: { fontSize: '0.9em', marginTop: '8px', marginBottom: '4px' }
      });

      state.autoAdverbFlags.slice(0, 3).forEach((flag, i) => {
        const key = `adverb-${i}`;
        const confidence = getConfidence(flag.score);
        const color = getConfidenceColor(confidence);
        const truncated = flag.sentence.length > 100 ? flag.sentence.substring(0, 100) + '...' : flag.sentence;
        const isExpanded = state.expandedFlags.has(key);
        const isFetching = state.fetchingFlagKey === key;
        const cachedResult = state.flagCoachCache.get(key);
        const chevron = isExpanded ? 'v' : '>';

        const cardContent: any[] = [
          {
            type: 'button',
            text: `${chevron} ${flag.word} (adverb, ${confidence})`,
            style: {
              fontSize: '0.85em',
              textAlign: 'left',
              width: '100%',
              background: 'none',
              border: 'none',
              padding: '0',
              cursor: 'pointer',
              fontWeight: 'bold',
              opacity: isFetching ? 0.5 : 1
            },
            callback: async () => { await toggleFlagCoaching(key, flag.narration, 'adverb', flag.word, undefined, flag.context); }
          },
          {
            type: 'button',
            text: truncated,
            style: {
              fontSize: '0.8em',
              opacity: 0.75,
              marginTop: '2px',
              fontStyle: 'italic',
              textAlign: 'left',
              width: '100%',
              background: 'none',
              border: 'none',
              padding: '0',
              cursor: 'pointer'
            },
            callback: async () => { await toggleFlagCoaching(key, flag.narration, 'adverb', flag.word, undefined, flag.context); }
          }
        ];

        if (isExpanded) {
          if (isFetching) {
            cardContent.push({
              type: 'text',
              text: 'Fetching adverb coaching...',
              style: { fontSize: '0.82em', opacity: 0.7, marginTop: '6px', paddingLeft: '4px' }
            });
          } else if (cachedResult) {
            for (const item of buildCoachingResultItems(
              cachedResult,
              flag.narration,
              async () => { await retryInlineCoaching(key, async () => await coachAdverb(flag.narration, flag.word, flag.context)); }
            )) {
              cardContent.push(item);
            }
          }
        }

        autoContent.push({
          type: 'box',
          style: {
            backgroundColor: 'bg1',
            padding: '6px 8px',
            borderRadius: '4px',
            marginBottom: '4px',
            borderLeft: `3px solid ${color}`,
            cursor: 'pointer'
          },
          content: cardContent
        });
      });
    }

    // Passive voice flags - conservative, manual-only review
    if (state.autoPassiveFlags.length > 0) {
      const visiblePassiveFlags = state.autoPassiveFlags.filter(flag => getConfidence(flag.score) !== 'low');
      const displayedPassiveFlags = (visiblePassiveFlags.length > 0 ? visiblePassiveFlags : state.autoPassiveFlags).slice(0, 2);
      const flagLabel = state.autoPassiveFlags.length === 1 ? '1 passive phrase' : `${state.autoPassiveFlags.length} passive phrases`;
      autoContent.push({
        type: 'text',
        text: `**Passive phrasing** - ${flagLabel} noticed:`,
        markdown: true,
        style: { fontSize: '0.9em', marginTop: '8px', marginBottom: '4px', opacity: visiblePassiveFlags.length > 0 ? 1 : 0.75 }
      });

      displayedPassiveFlags.forEach((flag, i) => {
        const key = `passive-${i}`;
        const confidence = getConfidence(flag.score);
        const color = getConfidenceColor(confidence);
        const truncated = flag.sentence.length > 100 ? flag.sentence.substring(0, 100) + '...' : flag.sentence;
        const isExpanded = state.expandedFlags.has(key);
        const isFetching = state.fetchingFlagKey === key;
        const cachedResult = state.flagCoachCache.get(key);
        const chevron = isExpanded ? 'v' : '>';

        const cardContent: any[] = [
          {
            type: 'button',
            text: `${chevron} ${flag.phrase} (passive, ${confidence})`,
            style: {
              fontSize: '0.85em',
              textAlign: 'left',
              width: '100%',
              background: 'none',
              border: 'none',
              padding: '0',
              cursor: 'pointer',
              fontWeight: 'bold',
              opacity: isFetching ? 0.5 : 1
            },
            callback: async () => { await toggleFlagCoaching(key, flag.narration, 'passive', flag.phrase, undefined, flag.context); }
          },
          {
            type: 'button',
            text: truncated,
            style: {
              fontSize: '0.8em',
              opacity: 0.75,
              marginTop: '2px',
              fontStyle: 'italic',
              textAlign: 'left',
              width: '100%',
              background: 'none',
              border: 'none',
              padding: '0',
              cursor: 'pointer'
            },
            callback: async () => { await toggleFlagCoaching(key, flag.narration, 'passive', flag.phrase, undefined, flag.context); }
          }
        ];

        if (isExpanded) {
          if (isFetching) {
            cardContent.push({
              type: 'text',
              text: 'Fetching passive voice coaching...',
              style: { fontSize: '0.82em', opacity: 0.7, marginTop: '6px', paddingLeft: '4px' }
            });
          } else if (cachedResult) {
            for (const item of buildCoachingResultItems(
              cachedResult,
              flag.narration,
              async () => { await retryInlineCoaching(key, async () => await coachPassive(flag.narration, flag.phrase, flag.context)); }
            )) {
              cardContent.push(item);
            }
          }
        }

        autoContent.push({
          type: 'box',
          style: {
            backgroundColor: 'bg1',
            padding: '6px 8px',
            borderRadius: '4px',
            marginBottom: '4px',
            borderLeft: `3px solid ${color}`,
            cursor: 'pointer',
            opacity: confidence === 'low' ? 0.78 : 1
          },
          content: cardContent
        });
      });
    }

    // Tag flags
    if (state.autoTagFlags.length > 0) {
      const flagLabel = state.autoTagFlags.length === 1 ? '1 tag' : `${state.autoTagFlags.length} tags`;
      autoContent.push({
        type: 'text',
        text: `**🏷 Action Tags** — ${flagLabel} flagged:`,
        markdown: true,
        style: { fontSize: '0.9em', marginTop: '8px', marginBottom: '4px' }
      });

      const visibleTagFlags = state.autoTagFlags.filter(flag => getConfidence(flag.score) !== 'low');
      const displayedTagFlags = (visibleTagFlags.length > 0 ? visibleTagFlags : state.autoTagFlags).slice(0, 3);

      displayedTagFlags.forEach((flag, i) => {
        const key = `tag-${i}`;
        const icon = flag.type === 'adverb_tag' ? '📝' : '🏷';
        const label = flag.type === 'adverb_tag' ? 'tag + adverb' : 'explanatory tag';
        const confidence = getConfidence(flag.score);
        const color = getConfidenceColor(confidence);
        const truncated = flag.sentence.length > 100 ? flag.sentence.substring(0, 100) + '...' : flag.sentence;
        const isExpanded = state.expandedFlags.has(key);
        const isFetching = state.fetchingFlagKey === key;
        const cachedResult = state.flagCoachCache.get(key);
        const chevron = isExpanded ? 'v' : '>';

        const cardContent: any[] = [
          {
            type: 'button',
            text: `${chevron} ${icon} ${flag.word} (${label}, ${confidence})`,
            style: {
              fontSize: '0.85em',
              textAlign: 'left',
              width: '100%',
              background: 'none',
              border: 'none',
              padding: '0',
              cursor: 'pointer',
              fontWeight: 'bold',
              opacity: isFetching ? 0.5 : 1
            },
            callback: async () => { await toggleFlagCoaching(key, flag.sentence, 'tag'); }
          },
          {
            type: 'button',
            text: truncated,
            style: {
              fontSize: '0.8em',
              opacity: 0.75,
              marginTop: '2px',
              fontStyle: 'italic',
              textAlign: 'left',
              width: '100%',
              background: 'none',
              border: 'none',
              padding: '0',
              cursor: 'pointer'
            },
            callback: async () => { await toggleFlagCoaching(key, flag.sentence, 'tag'); }
          }
        ];

        if (isExpanded) {
          if (isFetching) {
            cardContent.push({
              type: 'text',
              text: '⏳ Fetching coaching...',
              style: { fontSize: '0.82em', opacity: 0.7, marginTop: '6px', paddingLeft: '4px' }
            });
          } else if (cachedResult) {
            for (const item of buildCoachingResultItems(
              cachedResult,
              flag.sentence,
              async () => { await retryInlineCoaching(key, async () => await coachTags(flag.sentence)); }
            )) {
              cardContent.push(item);
            }
          }
        }

        autoContent.push({
          type: 'box',
          style: {
            backgroundColor: 'bg1',
            padding: '6px 8px',
            borderRadius: '4px',
            marginBottom: '4px',
            borderLeft: `3px solid ${color}`,
            cursor: 'pointer'
          },
          content: cardContent
        });
      });
    }

    // Render auto-detection content directly — no collapsible wrapper needed.
    // The flag cards themselves are the interactive elements; wrapping them
    // in a collapsible just adds a pointless extra click.
    content.push({
      type: 'text',
      text: '**🔍 Auto-Detection** — latest generation:',
      markdown: true,
      style: { fontSize: '0.9em', marginBottom: '6px' }
    });
    for (const item of autoContent) {
      content.push(item);
    }
  }

  // Coaching feed
  if (state.feed.length > 0) {
    const feedContent: any[] = [];

    for (const entry of state.feed.slice(0, 10)) {
      const modeLabel = entry.mode === 'sdt' ? '👁 Show-Don\'t-Tell' :
                        entry.mode === 'tag' ? '🏷 Action Tag' :
                        entry.mode === 'general' ? '💬 General' :
                        entry.mode === 'auto_sdt' ? '👁 Auto SDT' : '🏷 Auto Tag';

      const age = Math.round((Date.now() - entry.timestamp) / 1000);
      const ageText = age < 60 ? `${age}s ago` :
                      age < 3600 ? `${Math.round(age / 60)}m ago` :
                      `${Math.round(age / 3600)}h ago`;

      const borderColor = entry.mode === 'sdt' || entry.mode === 'auto_sdt' ? '#cc9944' :
                          entry.mode === 'tag' || entry.mode === 'auto_tag' ? '#4499cc' : '#aa88ff';

      // Build retry callback — re-runs the same coach mode on the original passage
      const capturedEntry = entry;
      const feedRetryCallback = async () => {
        if (state.isCoaching) {
          api.v1.ui.toast('Already coaching — please wait', { type: 'warning' });
          return;
        }
        state.isCoaching = true;
        await updatePanel();
        try {
          let freshFeedback = '';
          if (capturedEntry.mode === 'sdt') {
            freshFeedback = await coachSdt(capturedEntry.passage, undefined, 'selection');
          } else if (capturedEntry.mode === 'tag') {
            freshFeedback = await coachTags(capturedEntry.passage);
          } else if (capturedEntry.mode === 'general') {
            freshFeedback = await coachGeneral(capturedEntry.passage);
          }
          if (freshFeedback) {
            capturedEntry.feedback = freshFeedback;
            capturedEntry.timestamp = Date.now();
          }
        } catch (e) {
          api.v1.error('Feed retry error:', e);
          api.v1.ui.toast('Retry failed — check script log', { type: 'error' });
        } finally {
          state.isCoaching = false;
          await updatePanel();
        }
      };

      // Render feedback through buildCoachingResultItems so Copy/Retry/Replace buttons appear
      const feedbackContent: any[] = buildCoachingResultItems(
        entry.feedback,
        entry.passage,
        feedRetryCallback
      );

      feedContent.push({
        type: 'box',
        style: {
          backgroundColor: 'bg1',
          padding: '8px',
          borderRadius: '4px',
          marginBottom: '8px',
          borderLeft: `3px solid ${borderColor}`
        },
        content: [
          {
            type: 'row',
            spacing: 'space-between',
            content: [
              {
                type: 'text',
                text: `**${modeLabel}**`,
                markdown: true,
                style: { fontSize: '0.85em' }
              },
              {
                type: 'text',
                text: ageText,
                style: { fontSize: '0.8em', opacity: 0.6 }
              }
            ]
          },
          {
            type: 'text',
            text: `_"${entry.text}"_`,
            markdown: true,
            style: { fontSize: '0.8em', opacity: 0.7, marginBottom: '6px', marginTop: '2px' }
          },
          ...feedbackContent
        ]
      });
    }

    content.push({
      type: 'collapsibleSection',
      title: `📋 Coaching Feed (${state.feed.length})`,
      content: feedContent,
      startOpen: state.feed.length > 0 && !hasAutoFlags
    });
  }

  // Empty state
  if (!hasAutoFlags && state.feed.length === 0 && !state.isCoaching) {
    content.push({
      type: 'box',
      style: {
        backgroundColor: 'bg1',
        padding: '12px',
        borderRadius: '4px',
        marginTop: '8px'
      },
      content: [
        {
          type: 'text',
          text: '_Nothing to show yet._',
          markdown: true,
          style: { opacity: 0.6 }
        },
        {
          type: 'text',
          text: 'Generate some text or select a passage and right-click to get coaching.',
          style: { fontSize: '0.85em', opacity: 0.5, marginTop: '4px' }
        }
      ]
    });
  }

  // Clear feed button
  if (state.feed.length > 0) {
    content.push({
      type: 'button',
      text: '🗑 Clear Feed',
      style: { fontSize: '0.85em', marginTop: '8px', opacity: 0.6 },
      callback: async () => {
        state.feed = [];
        await updatePanel();
      }
    });
  }

  // Info
  content.push({
    type: 'text',
    text: '_Click a flag card to fetch surgical coaching inline. Right-click document selection for manual sessions._',
    markdown: true,
    style: { fontSize: '0.8em', opacity: 0.5, marginTop: '12px' }
  });

  return content;
}

async function registerUI(): Promise<void> {
  await api.v1.ui.register([
    {
      type: 'sidebarPanel',
      id: state.panelId,
      name: 'Prose Coach',
      iconId: 'feather',
      content: buildPanelContent()
    },
    {
      type: 'contextMenuButton',
      id: 'prose-coach-sdt',
      text: '👁 Coach: Show-Don\'t-Tell',
      callback: async ({ selection }) => {
        if (!selection) {
          api.v1.ui.toast('Select a passage first', { type: 'warning' });
          return;
        }
        await runContextMenuCoach(selection, 'sdt');
      }
    },
    {
      type: 'contextMenuButton',
      id: 'prose-coach-tag',
      text: '🏷 Coach: Action Tags',
      callback: async ({ selection }) => {
        if (!selection) {
          api.v1.ui.toast('Select a passage first', { type: 'warning' });
          return;
        }
        await runContextMenuCoach(selection, 'tag');
      }
    },
    {
      type: 'contextMenuButton',
      id: 'prose-coach-general',
      text: '💬 Coach: General',
      callback: async ({ selection }) => {
        if (!selection) {
          api.v1.ui.toast('Select a passage first', { type: 'warning' });
          return;
        }
        await runContextMenuCoach(selection, 'general');
      }
    }
  ]);
}

async function updatePanel(): Promise<void> {
  await api.v1.ui.update([
    {
      type: 'sidebarPanel',
      id: state.panelId,
      name: 'Prose Coach',
      iconId: 'feather',
      content: buildPanelContent()
    }
  ]);
}

// ============================================================================
// HOOKS
// ============================================================================

function registerHooks(): void {
  // After generation: run auto-analysis (debounced 400ms)
  api.v1.hooks.register('onGenerationEnd', async () => {
    if (state.generationDebounceTimer !== null) {
      api.v1.timers.clearTimeout(state.generationDebounceTimer);
      state.generationDebounceTimer = null;
    }

    await loadConfig();
    if (!state.config.enableAutoScan) {
      return;
    }

    state.generationDebounceTimer = await api.v1.timers.setTimeout(async () => {
      state.generationDebounceTimer = null;
      if (!state.config.enableAutoScan) return;
      await runAutoAnalysis();
    }, 400);
  });
}

// ============================================================================
// ENTRY POINT
// ============================================================================

(async () => {
  await loadConfig();
  await registerUI();
  registerHooks();
})();
