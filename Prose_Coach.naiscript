  const lorebookContext = await getActivatedLorebookContext(`${passage}\n${context ?? ''}`);
  const prompt = `You are a surgical prose coach. The target narration sentence uses the adverb "${adverb}". Use the local context to understand meaning, but give one revised sentence for the target only. Explain what the adverb is trying to add, then strengthen the verb or action so the adverb is unnecessary. Preserve meaning, POV, and tone. Be direct and surgical — no preamble. Format: ISSUE: [adverb and what it is doing] | REVISION: [rewrite]\n\n${buildTargetContextBlock(passage, context)}${lorebookContext}`;

  try {
    const response = await generateWithBudgetWait(
      [{ role: 'user', content: prompt }],
      {
        model: 'glm-4-6',
        max_tokens: 300,
        temperature: state.config.temperature,
        stop: ['\n\n\n']
      },
      undefined,
      'background'
    );

    if (!response.choices || response.choices.length === 0) return '(No response)';
    return response.choices[0].text.trim();
  } catch (e) {
    api.v1.error('Adverb coach error:', e);
    return '(Error generating coaching)';
  }
}

async function coachPassive(passage: string, phrase: string, context?: string): Promise<string> {
  const lorebookContext = await getActivatedLorebookContext(`${passage}\n${context ?? ''}`);
  const prompt = `You are a surgical prose coach. The target narration sentence may use passive voice in "${phrase}". Use the local context to understand meaning, but give one revised sentence for the target only. Explain whether the passive construction weakens the sentence, then give one active-voice revision only if the active version preserves POV, agency, mystery, and emphasis. If passive voice is better here, say so and keep the revision close. Be direct and surgical â€” no preamble. Format: ISSUE: [passive phrase and effect] | REVISION: [rewrite]\n\n${buildTargetContextBlock(passage, context)}${lorebookContext}`;

  try {
    const response = await generateWithBudgetWait(
      [{ role: 'user', content: prompt }],
      {
        model: 'glm-4-6',
        max_tokens: 300,
        temperature: state.config.temperature,
        stop: ['\n\n\n']
      },
      undefined,
      'background'
    );

    if (!response.choices || response.choices.length === 0) return '(No response)';
    return response.choices[0].text.trim();
